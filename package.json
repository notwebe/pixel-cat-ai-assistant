{
  "name": "ai-assistant-character",
  "version": "1.0.0",
  "private": true,
  "description": "Customizable 2D/PNGTuber floating desktop AI assistant character for Windows powered by Google Gemini & OrcaRouter (screen vision, audio transcription, and standalone .exe packaging).",
  "author": "notwebe",
  "repository": {
    "type": "git",
    "url": "https://github.com/notwebe/pixel-cat-ai-assistant.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:vite": "node ./node_modules/vite/bin/vite.js",
    "dev:electron": "node ./scripts/build-electron.mjs && node ./node_modules/electron/cli.js .",
    "build:electron": "node ./scripts/build-electron.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit && node ./node_modules/vite/bin/vite.js build && node ./scripts/build-electron.mjs",
    "start": "node ./node_modules/electron/cli.js .",
    "launch": "node ./scripts/launch.mjs",
    "generate:icon": "node ./scripts/generate-icon.mjs",
    "package": "node ./scripts/dist.mjs --portable",
    "dist": "node ./scripts/dist.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "build": {
    "appId": "com.notwebe.pixel-cat-ai-assistant",
    "productName": "Pixel Cat Assistant",
    "compression": "maximum",
    "afterPack": "./scripts/after-pack.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "!node_modules/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PixelCatAssistant.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Cat Assistant",
      "artifactName": "PixelCatAssistant-Setup-${version}.exe"
    }
  },
  "keywords": [
    "electron",
    "ai-assistant",
    "desktop-pet",
    "pngtuber",
    "gemini",
    "orcarouter",
    "screenshot",
    "transcription"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7"
  }
}
